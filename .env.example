# Copie este arquivo para ".env.local" e preencha os valores reais.
# NUNCA suba o ".env.local" para o GitHub.

# Supabase — em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (sem barra no final). Em produção, a URL real do domínio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago — Access Token de produção (Suas integrações > Credenciais)
# Deixe em branco para testar o site com o pagamento "desligado":
# a inscrição fica registrada como pendente e o pagamento é ativado depois.
MERCADOPAGO_ACCESS_TOKEN=

# Painel administrativo
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
